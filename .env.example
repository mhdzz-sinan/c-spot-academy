# ============================================================================
# C-Spot Academy — Environment Variables Configuration
# Copy this file to .env.local and fill in your credentials
# ============================================================================

# 1. CASHFREE PAYMENT GATEWAY
# Obtain from https://merchant.cashfree.com/ (or https://sandbox.cashfree.com/)
CASHFREE_CLIENT_ID=your_cashfree_client_id
CASHFREE_CLIENT_SECRET=your_cashfree_client_secret
CASHFREE_ENV=sandbox
CASHFREE_API_VERSION=2023-08-01

# 2. SUPABASE POSTGRESQL & AUTH
# Obtain from Supabase Project Settings -> API
# Note: When left as placeholders, the app automatically uses an in-memory
# sandbox repository pre-seeded with the SolidWorks CAD Bootcamp for local testing.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# 3. APPLICATION & SECURITY CONFIGURATION
NEXT_PUBLIC_APP_URL=http://localhost:3000
JWT_SECRET=replace_with_a_strong_random_64_char_hex_secret_for_production
ADMIN_ACCESS_PASSWORD=cspot_admin_2026_secure

# 4. TELEGRAM GROUP ACCESS (Also configurable dynamically via Admin Dashboard)
TELEGRAM_GROUP_INVITE_URL=https://t.me/cspotofficial
